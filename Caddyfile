# ─────────────────────────────────────────────────────────────────────────────
# REFERENCE COPY of the admin-UI site block.
#
# The file Caddy actually runs is /opt/homebrew/etc/Caddyfile (a root
# LaunchDaemon: `sudo brew services start caddy`). That installed file carries
# this same :8080 site — under a longer header recording why it changed — plus a
# second site, an `app.codiapay.com:443` LAN fast path used only by EA instances
# on other machines, which has nothing to do with the UI and is not reproduced
# here.
#
# cloudflared maps app.codiapay.com → localhost:8080, so this block is what the
# outside world reaches. Until 2026-09-19 its catch-all proxied `ng serve`,
# which made every source edit a live deploy to the operator console; it now
# serves a compiled release off disk and no Node process is in the path at all.
#
# Keep the two in sync when you change this one:
#
#     cp Caddyfile /opt/homebrew/etc/Caddyfile   # then re-append the LAN block
#     caddy reload --config /opt/homebrew/etc/Caddyfile
#
# Deploying the UI does NOT require touching either file — `scripts/release.sh
# publish` swaps a symlink underneath the root below.
# ─────────────────────────────────────────────────────────────────────────────

:8080 {
	# ── Security headers at the edge (multi-tenancy f1-prod P1.5, 2026-10-20) ─────────────────────────
	# HSTS for the public console host; browsers honour it only on HTTPS (via Cloudflare), so one
	# site-wide line is safe on http://localhost:8080 too. The engine never sends HSTS itself. Start at
	# one day, no includeSubDomains, no preload; raise to 30 d after a clean week, then 1 y.
	header Strict-Transport-Security "max-age=86400"

	# Engine responses: no MIME sniffing and no server banner, also on error answers.
	@engine_response path /api/* /health*
	header @engine_response {
		X-Content-Type-Options nosniff
		-Server
		defer
	}

	# Auth answers carry tokens, API keys and session cookies: no cache may keep them.
	@engine_auth path /api/v1/lascodia-trading-engine/auth/* /api/v1/lascodia-trading-engine/admin/auth/*
	header @engine_auth {
		Cache-Control "no-store"
		Pragma "no-cache"
		defer
	}

	# Engine API — anything under /api/* tunnels straight to the Docker
	# container's exposed port. Cloudflared can't reach this port directly
	# from outside, hence the proxy. This also carries the SignalR hub at
	# /api/hubs/trading; reverse_proxy upgrades WebSockets automatically.
	# SECURITY (2026-10-19): never forward the engine's dev-token endpoint. It mints an ADMIN JWT
	# (valid ~1 year, any role the caller asks for) with no password whenever the engine runs with
	# ASPNETCORE_ENVIRONMENT=Development -- which the live engine does. Through this site that was
	# a public, passwordless Admin login. Nothing operational uses it: EAs authenticate with
	# /auth/login, /auth/register and /auth/refresh; it exists for local development against :5081
	# directly. A single path matcher, so it sorts ahead of `handle /api/*`; Caddy path matching is
	# case-insensitive and the trailing * covers `/auth/token/`.
	handle /api/v1/lascodia-trading-engine/auth/token* {
		respond 404
	}

	# SECURITY (2026-10-19, multi-tenancy program Phase 0): this site is the PUBLIC one (cloudflared).
	# /auth/register handed an existing account's plaintext EA API key + an EA JWT to anyone who sent
	# its account number + broker server, and /admin/terminals/daemons/auth is anonymous trust-on-first-use
	# that mints an EA-role JWT for any unused DaemonId. Neither has a public caller: EAs hold persisted
	# API keys and use /auth/login; mac2 EAs bootstrap through the LAN site below; the MT5 supervisor
	# talks to localhost:5081 directly. Keep these blocks until the engine-side fixes ship and are verified.
	handle /api/v1/lascodia-trading-engine/auth/register* {
		respond 404
	}
	handle /api/v1/lascodia-trading-engine/admin/terminals/daemons/auth* {
		respond 404
	}

	handle /api/* {
		# SS-08 (chart + Pine program, 2026-10-09): the API's JSON is compressed HERE, in Caddy, not in the money-path
		# engine — the client's Accept-Encoding is not forwarded. Never for EA traffic (X-EA-Instance-ID), the SignalR
		# hub, or /auth; only JSON responses of 1 KB or more. Reference copy: admin-ui repo Caddyfile.
		@compressible_api {
			header !X-EA-Instance-ID
			not path /api/hubs/*
			not path /api/v1/lascodia-trading-engine/auth/*
		}
		encode @compressible_api zstd gzip {
			minimum_length 1024
			match {
				header Content-Type application/json*
				header Content-Type application/problem+json*
			}
		}
		# SS-I4 (chart + Pine program, 2026-10-09): the scripting API and its hub run in the research process (Pine CPU
		# off the money path; research publishes 127.0.0.1:5083). strategy/{id}/script/* stays on api (the live sessions
		# live there). Roll back: put back the single `reverse_proxy localhost:5081 { header_up -Accept-Encoding }`.
		# Enterprise onboarding: the anonymous public demo (demo, demo/*) reads the market-data store and keeps the recorded
		# window in memory — research, so anonymous traffic never lands on the money-path process.
		@scripting path /api/v1/lascodia-trading-engine/scripting/* /api/v1/lascodia-trading-engine/chart-flow/* /api/v1/lascodia-trading-engine/md/history /api/v1/lascodia-trading-engine/md/orderflow /api/v1/lascodia-trading-engine/md/orderflow/* /api/v1/lascodia-trading-engine/demo /api/v1/lascodia-trading-engine/demo/* /api/v1/lascodia-trading-engine/dealing/* /api/v1/lascodia-trading-engine/futures/continuous /api/v1/lascodia-trading-engine/md/crypto/orderflow /api/hubs/scripting /api/hubs/scripting/*
		route {
			# SECURITY (2026-10-19, multi-tenancy Phase 0): every request through this PUBLIC site is
			# marked so the engine never treats it as a trusted network, whatever address it appears
			# from (cloudflared reaches Caddy on loopback). header_up overwrites a client-sent value.
			reverse_proxy @scripting localhost:5083 {
				header_up -Accept-Encoding
				header_up X-Lascodia-Edge public
			}
			reverse_proxy localhost:5081 {
				header_up -Accept-Encoding
				header_up X-Lascodia-Edge public
			}
		}
	}

	# Health probes live at the SERVER ROOT (/health, /health/live,
	# /health/ready), not under /api/*. Without this they fell through to the
	# catch-all below and returned 404 HTML, so every EA reaching the engine
	# through this tunnel logged "Health check failed (HTTP 404)" every 30s.
	# That feeds ConnectionMonitor, which counts it toward "engine unreachable"
	# -- i.e. a proxy routing gap was contributing to SAFE_MODE entries on the
	# remote instances. Local instances talk to :5081 directly and never saw it,
	# which is why it looked EA-specific.
	#
	# Now that the catch-all is a static SPA file server, losing this block
	# would be WORSE, not better: try_files would answer /health with
	# index.html and HTTP 200, so every EA would read a dead engine as healthy
	# and the dead-man switch would never fire. Do not remove it.
	handle /health* {
		reverse_proxy localhost:5081 {
			header_up X-Lascodia-Edge public
		}
	}

	# Keycloak (ADR-0030, multi-tenancy W1): the lascodia realm and its static login assets only. The
	# admin console and admin REST API (/idp/admin/*), the master realm and the welcome page are never
	# served on this public site (admin console: the loopback-only http://localhost:8181 site below).
	# cloudflared -> Caddy is plain HTTP, so the scheme is asserted; the client is Cf-Connecting-IP.
	handle /idp/realms/lascodia/* {
		reverse_proxy localhost:8180 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host app.codiapay.com
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
		}
	}
	handle /idp/resources/* {
		reverse_proxy localhost:8180 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host app.codiapay.com
			header_up X-Forwarded-For {http.request.header.Cf-Connecting-IP}
		}
	}
	handle /idp* {
		respond 404
	}

	# The compiled admin UI.
	handle {
		root * /opt/homebrew/var/www/lascodia-admin/current

		# Two cache classes, mutually exclusive by construction.
		#
		# Angular's production build emits content-addressed filenames
		# (`chunk-245PJLHT.js`, `styles-ABCD1234.css`): the bytes can never
		# change under a given name, so they are safe to cache for a year. A
		# deploy publishes NEW names and index.html points at them.
		#
		# Everything else — index.html, config.json, the unhashed icons copied
		# out of public/, and every SPA deep link that try_files rewrites to
		# index.html — gets `no-cache`, which is "store it but revalidate before
		# use". The browser still gets a cheap 304 for an unchanged 122 kB icon,
		# but a redeploy is picked up on the very next load instead of serving a
		# stale shell that references chunks which no longer exist.
		#
		# `header` runs BEFORE try_files in Caddy's directive order, so these
		# match the ORIGINAL request path — which is what makes the deep-link
		# case land in the no-cache class rather than looking like index.html.
		@hashed path_regexp (\-[A-Z0-9]{8,}|/(chunk|main|polyfills)-[A-Za-z0-9_-]{8})\.[a-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		@revalidate not path_regexp (\-[A-Z0-9]{8,}|/(chunk|main|polyfills)-[A-Za-z0-9_-]{8})\.[a-z0-9]+$
		header @revalidate Cache-Control "no-cache"

		# ── Content-Security-Policy, ENFORCING ──────────────────────────────
		#
		# Enforcing, but only after a measured report-only pass — a CSP that is
		# one directive short fails CLOSED on a single page, silently, for
		# whoever happens to open it, which is why this was never copied over
		# from docker/nginx.conf on trust.
		#
		# Verified 2026-09-19 in report-only mode: every one of the 74 routes the
		# sidebar exposes, swept with the browser console captured, reported ZERO
		# violations — plus the interaction paths most likely to trip a policy:
		# drawing on the chart, adding a study, the canvas→PNG snapshot download,
		# and the assistant bubble.
		#
		# `worker-src blob:` is not in the nginx copy and is needed here; the
		# chart and several ML pages create workers from blob URLs.
		#
		# TO ROLL BACK: rename this header to `Content-Security-Policy-Report-Only`
		# and `caddy reload`. That restores reporting without blocking, which is
		# the right first move if a page ever breaks in a way CSP could explain.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			# `display-capture=(self)` is what lets the assistant see the screen.
			#
			# It is NOT a relaxation of the three below: camera, microphone and
			# geolocation stay denied outright. Screen capture is a different
			# permission with a different prompt — the browser still asks, the
			# operator still picks the surface, and its sharing indicator is lit for
			# the whole session. Without this line `getDisplayMedia` is refused by
			# policy before any of that happens, and the only symptom is the toggle
			# silently failing to turn on.
			Permissions-Policy "camera=(), microphone=(), geolocation=(), display-capture=(self)"
			-Server
		}

		encode zstd gzip

		# SPA fallback: client-side routes (/ea-instances, /market-data/...)
		# are not files on disk, so they must resolve to the shell.
		try_files {path} /index.html
		file_server
	}
}

# Keycloak admin console — loopback only (ADR-0030, multi-tenancy W1).
http://localhost:8181 {
	bind 127.0.0.1 ::1
	reverse_proxy localhost:8180
}
