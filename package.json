{
  "name": "lascodia-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "release": "scripts/release.sh publish",
    "release:status": "scripts/release.sh status",
    "release:list": "scripts/release.sh list",
    "release:rollback": "scripts/release.sh rollback",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:components": "vitest run --config vitest.components.config.mts",
    "test:components:watch": "vitest --config vitest.components.config.mts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "icons": "node scripts/generate-icons.mjs",
    "codegen:api": "npx --yes openapi-typescript@^7.13.0 \"${SWAGGER_URL:-http://localhost:5000/swagger/v1/swagger.json}\" -o src/app/core/api/_generated/schema.ts",
    "storybook": "ng run lascodia-admin:storybook",
    "storybook:build": "ng run lascodia-admin:build-storybook",
    "lhci": "npx --yes @lhci/cli@^0.15.1 autorun",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "eslint --fix"
    ],
    "*.{ts,html,scss,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "@lucide/angular": "^1.49.0",
    "@microsoft/signalr": "^10.0.0",
    "@ngrx/signals": "^22.0.1",
    "@sentry/angular": "^10.57.0",
    "ag-grid-angular": "^35.1.0",
    "ag-grid-community": "^35.1.0",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "modern-screenshot": "^4.7.0",
    "ngx-echarts": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "web-vitals": "^5.2.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular-eslint/template-parser": "^22.5.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  }
}
