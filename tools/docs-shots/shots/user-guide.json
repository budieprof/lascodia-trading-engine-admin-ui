  {
    "name": "chart-ladder",
    "route": "/chart-analysis/EURUSD",
    "settle": 8000,
    "steps": [
      {
        "click": "[data-testid=ladder-button]"
      },
      {
        "wait": 9000
      }
    ],
    "crop": {
      "sel": "aside.side-pane",
      "pad": 4
