[
  {
    "name": "ma-config-search",
    "route": "/engine-config",
    "settle": 3500,
    "steps": [
      {
        "fill": ["input[aria-label='Search keys or descriptions']", "Execution:"]
      },
      {
        "wait": 800
      }
    ],
    "marks": [
      {
        "sel": "input[aria-label='Search keys or descriptions']",
        "n": 1
      },
      {
        "sel": "td.col-value",
        "nth": 0,
        "n": 2
      },
      {
        "sel": "button.save-btn.small",
        "nth": 0,
        "n": 3
      }
    ]
  },
  {
    "name": "ma-config-review",
    "route": "/engine-config",
    "settle": 3500,
    "steps": [
      {
        "fill": [
          "input[aria-label='Search keys or descriptions']",
          "Risk:MultiAsset:Crypto:Leverage"
        ]
      },
      {
        "wait": 800
      },
      {
        "fill": ["tr:has(code[title='Risk:MultiAsset:Crypto:Leverage']) input.config-input", "5"]
      },
      {
        "wait": 300
      },
      {
        "click": "tr:has(code[title='Risk:MultiAsset:Crypto:Leverage']) button.save-btn.small"
      },
      {
        "wait": 600
      }
    ],
    "crop": {
      "sel": ".review",
      "pad": 16
    },
    "marks": [
      {
        "sel": ".review-field textarea",
        "n": 1
      },
      {
        "sel": ".review-ack",
        "n": 2
      },
      {
        "sel": ".review-actions .save-btn",
        "n": 3
      }
    ]
  },
  {
    "name": "ma-margins",
    "route": "/reference/margin-requirements",
    "steps": [
      {
        "fill": ["input[name='f-sym']", "*"]
      },
      {
        "press": "Enter"
      },
      {
        "wait": 1500
      }
    ],
    "marks": [
      {
        "sel": "select[name='f-kind']",
        "n": 1
      },
      {
        "sel": "p.note",
        "nth": 0,
        "n": 2,
        "pad": 2
      },
      {
        "sel": "table.grid tbody tr",
        "nth": 0,
        "n": 3,
        "pad": 2
      },
      {
        "sel": "button",
        "text": "Add a row",
        "n": 4
      }
    ]
  },
  {
    "name": "ma-margin-form",
    "route": "/reference/margin-requirements",
    "steps": [
      {
        "clickText": "Add a row",
        "exact": true
      },
      {
        "wait": 600
      }
    ],
    "crop": {
      "sel": "section[aria-label='Margin requirement row']",
      "pad": 16
    }
  },
  {
    "name": "ma-margin-import",
    "route": "/reference/margin-requirements",
    "stub": [
      {
        "method": "POST",
        "path": "/reference/margin-requirements/import$",
        "json": {
          "data": {
            "dryRun": true,
            "inserted": 2,
            "alreadyPresent": 0,
            "errors": [],
            "rows": [
              {
                "id": 0,
                "kind": "FuturesContract",
                "symbol": "6E",
                "venue": null,
                "currency": "USD",
                "initialMargin": 2900,
                "maintenanceMargin": 2650,
                "intradayInitialMargin": null,
                "intradayMaintenanceMargin": null,
                "notionalFloor": null,
                "notionalCap": null,
                "maxLeverage": null,
                "initialMarginRate": null,
                "maintenanceMarginRate": null,
                "maintenanceAmount": null,
                "effectiveFromUtc": "2026-11-02T00:00:00Z",
                "source": "CME margins page read 2026-11-02",
                "createdAtUtc": "2026-10-28T00:00:00Z",
                "updatedAtUtc": "2026-10-28T00:00:00Z",
                "isDeleted": false,
                "inForce": false
              },
              {
                "id": 0,
                "kind": "FuturesContract",
                "symbol": "ES",
                "venue": null,
                "currency": "USD",
                "initialMargin": 24000,
                "maintenanceMargin": 22000,
                "intradayInitialMargin": null,
                "intradayMaintenanceMargin": null,
                "notionalFloor": null,
                "notionalCap": null,
                "maxLeverage": null,
                "initialMarginRate": null,
                "maintenanceMarginRate": null,
                "maintenanceAmount": null,
                "effectiveFromUtc": "2026-11-02T00:00:00Z",
                "source": "CME margins page read 2026-11-02",
                "createdAtUtc": "2026-10-28T00:00:00Z",
                "updatedAtUtc": "2026-10-28T00:00:00Z",
                "isDeleted": false,
                "inForce": false
              }
            ]
          },
          "status": true,
          "message": "Successful",
          "responseCode": "00"
        }
      }
    ],
    "steps": [
      {
        "clickText": "Import CSV",
        "exact": true
      },
      {
        "wait": 400
      },
      {
        "fill": [
          "textarea[name='i-csv']",
          "Kind,Symbol,Venue,Currency,EffectiveFromUtc,InitialMargin,MaintenanceMargin,Source\nFuturesContract,6E,,USD,2026-11-02,2900,2650,\"CME margins page read 2026-11-02\"\nFuturesContract,ES,,USD,2026-11-02,24000,22000,\"CME margins page read 2026-11-02\"\n"
        ]
      },
      {
        "fill": ["input[name='i-reason']", "CME margins 2026-11"]
      },
      {
        "click": "[data-testid=margin-import-check]"
      },
      {
        "waitFor": "[data-testid=margin-import-result]"
      },
      {
        "wait": 300
      }
    ],
    "crop": {
      "sel": "section[aria-label='Import margin rows from a CSV file']",
      "pad": 16
    },
    "marks": [
      {
        "sel": "[data-testid=margin-import-file]",
        "n": 1
      },
      {
        "sel": "[data-testid=margin-import-check]",
        "n": 2
      },
      {
        "sel": "[data-testid=margin-import-result]",
        "n": 3
      },
      {
        "sel": "[data-testid=margin-import-submit]",
        "n": 4
      }
    ]
  },
